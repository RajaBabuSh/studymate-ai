# StudyMate AI - Environment Variables
# Copy to .env.local and populate with your credentials

# Gemini Multimodal AI (for syllabus & exam timetable OCR)
GEMINI_API_KEY=

# Supabase Auth & Database (Required for live multi-user cloud persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Authentication
ADMIN_EMAIL=admin@studymate.ai
ADMIN_PASSWORD=
