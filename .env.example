# StudyMate AI - Environment Variables
# Copy to .env.local and populate with your credentials

# Gemini Multimodal AI (for syllabus & exam timetable OCR)
GEMINI_API_KEY=

# Supabase Auth & Cloud Database
# Expected URL format: https://YOUR_PROJECT_REF.supabase.co
# IMPORTANT:
# - Do NOT use an API key as the URL
# - Do NOT use a Supabase Dashboard URL (https://supabase.com/dashboard/...)
# - Do NOT use a database connection string (postgres://...)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Secret Server-Only Service Role Key (Do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Admin Authentication
ADMIN_EMAIL=admin@studymate.ai
ADMIN_PASSWORD=
